{
  "agy-hyper-lifecycle": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "./bin/agy-hyper hook session-start",
        "timeout": 4
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./bin/agy-hyper hook pre-invocation",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/agy-hyper hook post-tool-use",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./bin/agy-hyper hook stop",
        "timeout": 5
      }
    ]
  }
}
